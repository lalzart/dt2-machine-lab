  "supported_block_frames": [
    1,
    16,
    32
  ],
  "timeline_convention": "Unsigned sample ticks; inputs before clock at equal ticks; off before on; exclude host time",
  "title": "UP keyboard arp first experiment",
  "tolerances": {
    "core_order": "exact",
    "state_repeat": "all bytes equal",
    "core_deadline": "0 through block_frames-1 output samples",
