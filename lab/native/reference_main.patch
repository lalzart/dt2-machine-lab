+    /// Execute a patched image using anchors resolved from authenticated stock
+    /// firmware. The reference supplies only service addresses and the profile;
+    /// RAM and emulated flash always contain the candidate's own bytes.
+    /// The caller must preserve those service addresses and ABIs in its patch.
+    pub fn new_patched_with_reference(
+        syx: &[u8],
+        card: Option<Card>,
+        stock_syx: &[u8],
+    ) -> Result<Self, String> {
+        let reference = parse(stock_syx).map_err(|e| format!("parse reference: {e}"))?;
+        let mains: Vec<_> = reference.sections.iter().filter(|s| s.id == 3).collect();
+        if mains.len() != 1 || mains[0].destination != MAIN_LOAD {
+            return Err("reference requires one MAIN at its stock destination".into());
+        }
+        let base = digest(stock_syx);
+        let registry = device_profile::Registry::load().map_err(|e| e.to_string())?;
+        registry.boot_for_main(&base, &mains[0].bytes)
+            .map_err(|e| format!("untrusted reference firmware: {e}"))?;
+        Self::build_resolved(syx, card, ExecutionPolicy::Reference,
+            Some(&base), Some(&mains[0].bytes))
+    }
